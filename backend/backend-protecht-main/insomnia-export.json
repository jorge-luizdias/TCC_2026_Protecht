      - url: "{{ _.base_url }}/api/complaints"
        name: Criar denuncia
        meta:
          id: req_f2ceee2d5c2a43329b87aad962d27e5d
          created: 0
          modified: 1787784396029
          isPrivate: false
          description: ""
          sortKey: 400
        method: POST
        body:
          mimeType: multipart/form-data
          params:
            - name: user_id_course
              value: "{{ _.cursoId }}"
              type: text
            - name: user_id_enrollment_year
              value: "2026"
              type: text
            - name: reported_user_name
              value: "{% faker 'randomFullName' %}"
              type: text
            - name: reported_user_id_course
              value: "{{ _.cursoId }}"
              type: text
            - name: reported_user_id_enrollment_year
              value: "2025"
              type: text
            - name: is_anonymous
              value: "{{_.ano }}"
              type: text
            - name: category
              value: "{{_.tipoDenuncia}}"
              type: text
            - name: description
              value: "{% prompt 'ProtechtBD', 'Digite a Denúncia', 'Entre aqui com os detalhes
                das denúncias', '', false, true %}"
              type: text
            - name: incident_date
              value: 2026-08-26T12:00:00.000Z
              type: text
            - name: photo_1
              fileName: C:\Users\Graziani Zanfolin\Downloads\notas\001 - Copia.png
              type: file
            - name: photo_2
              fileName: ""
              type: file
            - name: photo_3
              fileName: ""
              type: file
        authentication:
          type: bearer
          token: "{% response 'body', 'req_b7a0b7919bc1486489707d9486bb2d4c',
            'b64::JC50b2tlbg==::46b', 'never', 60 %}"
        scripts:
          preRequest: >-
            const baseUrl = insomnia.variables.get('base_url');


            const resp = await new Promise((resolve, reject) => {
              insomnia.sendRequest(`${baseUrl}/api/courses`, (err, res) =>
                err ? reject(err) : resolve(res)
              );
            });


            const cursos = resp.json();


            if (!Array.isArray(cursos) || cursos.length === 0) {
              throw new Error('Lista de cursos vazia ou em formato inesperado');
            }


            const tiposDenuncia = [
              'BULLYING',
              'ASSEDIO',
              'VANDALISMO',
              'DISCRIMINACAO',
              'USO_DE_SUBSTANCIAS'
            ];


            const anos = [2024, 2025, 2026];


            const sortear = lista => lista[Math.floor(Math.random() *
            lista.length)];


            const curso = sortear(cursos);

            const tipo = sortear(tiposDenuncia);

            const ano = sortear(anos);


            insomnia.variables.set('cursoId', String(curso.id));

            insomnia.variables.set('tipoDenuncia', tipo);

            insomnia.variables.set('ano', String(ano));


            console.log(`curso: ${curso.name} | tipo: ${tipo} | ano: ${ano}`);
        settings:
          renderRequestBody: true
          encodeUrl: true
          followRedirects: global
          cookies:
            send: true
            store: true
          rebuildPath: true
